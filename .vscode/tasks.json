{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsup",
        "pattern": { "regexp": "^x^" },
        "background": {
          "beginsPattern": "Build start",
          "endsPattern": "Build success"
        }
      }
    }
  ]
}
